2026-01-01 open Assets:Btc
2026-01-01 open Assets:Bank

2026-01-02 * "an expression in a price"
  Assets:Btc    2 BTC @ (10 + 5) EUR
  Assets:Bank  -30 EUR

2026-01-03 * "an expression in a total price"
  Assets:Btc    4 BTC @@ (20 / 4) EUR
  Assets:Bank  -5 EUR

2026-01-04 * "an expression in units and a cost"
  Assets:Btc    (1 + 1) BTC {3 * 4 EUR}
  Assets:Bank  -24 EUR

2026-01-05 * "inexact total, places written"
  Assets:Btc    3 BTC @@ 10.00 EUR
  Assets:Bank  -10.00 EUR

2026-01-06 * "inexact total cost"
  Assets:Btc    3 BTC {{10.00 EUR}}
  Assets:Bank  -10.00 EUR

2026-01-07 * "total price on fractional units"
  Assets:Btc    0.5 BTC @@ 100 EUR
  Assets:Bank  -100 EUR

2026-01-08 * "a very small rate"
  Assets:Btc    10000000 BTC @@ 1 EUR
  Assets:Bank  -1 EUR

2026-01-09 * "a large rate"
  Assets:Btc    0.001 BTC @@ 1000 EUR
  Assets:Bank  -1000 EUR

2026-01-10 * "a price with trailing zeros and a comma"
  Assets:Btc    1 BTC @ 1,234.500 EUR
  Assets:Bank  -1234.500 EUR

2026-01-11 * "a cost from a per-unit and a total"
  Assets:Btc    2 BTC {10 # 5 EUR}
  Assets:Bank  -25 EUR

2026-01-12 * "total price, negative units"
  Assets:Btc    -3 BTC @@ 10.00 EUR
  Assets:Bank   10.00 EUR

plugin "beancount.plugins.implicit_prices"
