plugin "beancount.plugins.implicit_prices"

2026-01-01 open Assets:Btc
2026-01-01 open Assets:Bank
2026-01-01 open Assets:Usd

2026-01-02 * "two transactions, same day, same rate"
  Assets:Btc    2 BTC @ 100.00 EUR
  Assets:Bank  -200.00 EUR

2026-01-02 * "two transactions, same day, same rate"
  Assets:Btc    5 BTC @ 100.00 EUR
  Assets:Bank  -500.00 EUR

2026-01-03 * "same value, other places"
  Assets:Btc    2 BTC @ 100.0 EUR
  Assets:Bank  -200.0 EUR

2026-01-03 * "same value, other places"
  Assets:Btc    2 BTC @ 100.000 EUR
  Assets:Bank  -200.000 EUR

2026-01-04 * "same rate, other quote currency"
  Assets:Btc    2 BTC @ 100 EUR
  Assets:Bank  -200 EUR

2026-01-04 * "same rate, other quote currency"
  Assets:Btc    2 BTC @ 100 USD
  Assets:Usd   -200 USD

2026-01-05 * "same rate, other units commodity"
  Assets:Btc    2 BTC @ 100 EUR
  Assets:Bank  -200 EUR

2026-01-05 * "same rate, other units commodity"
  Assets:Btc    2 ETH @ 100 EUR
  Assets:Bank  -200 EUR

