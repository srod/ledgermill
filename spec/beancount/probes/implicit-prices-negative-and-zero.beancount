  Assets:Btc    0 BTC @ 5 EUR
  Assets:Bank   0 EUR

2026-01-06 * "price of zero"
  Assets:Btc    1 BTC @ 0 EUR
  Assets:Bank   0 EUR

2026-01-07 * "price in the commodity of the units"
  Assets:Btc    1 BTC @ 2 BTC
  Assets:Bank  -2 BTC

plugin "beancount.plugins.implicit_prices"
