2026-01-01 open Assets:Btc
2026-01-01 open Assets:Bank
2026-01-01 open Assets:Other

2026-01-02 * "total cost on fractional units: the lot shows 200"
  Assets:Btc    0.5 BTC {{100 EUR}}
  Assets:Bank  -100 EUR

2026-01-03 * "cost written with an exponent-forming expression"
  Assets:Btc    1 BTC {(100 / 0.5) EUR}
  Assets:Bank  -200 EUR

2026-01-04 * "cost with places"
  Assets:Btc    2 BTC {10.50 EUR}
  Assets:Bank  -21.00 EUR

2026-01-05 * "total cost of 21.00 on two units"
  Assets:Btc    2 BTC {{21.00 EUR}}
  Assets:Bank  -21.00 EUR

2026-01-06 * "an equal lot written with another number of places"
  Assets:Btc    2 BTC {10.5 EUR}
  Assets:Bank  -21.0 EUR

2026-01-07 * "a cost of zero"
  Assets:Other  1 BTC {0 EUR}
  Assets:Bank   0 EUR

plugin "beancount.plugins.implicit_prices"
