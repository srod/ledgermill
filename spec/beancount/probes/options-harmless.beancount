option "title" "A title, with a comma"
option "operating_currency" "EUR"
option "operating_currency" "USD"
option "render_commas" "TRUE"
option "documents" "."
option "long_string_maxlines" "10"
option "conversion_currency" "NOTHING"
option "account_previous_balances" "Opening-Balances"
option "account_previous_earnings" "Earnings:Previous"
option "account_previous_conversions" "Conversions:Previous"
option "account_current_earnings" "Earnings:Current"
option "account_current_conversions" "Conversions:Current"
option "account_unrealized_gains" "Unrealized"
option "account_rounding" "Rounding"

2026-01-01 open Assets:A
2026-01-01 open Assets:B
2026-01-01 commodity EUR
2026-01-01 event "location" "Paris"
2026-01-01 note Assets:A "a note"
2026-01-01 custom "budget" Assets:A 100 EUR
2026-01-02 price EUR 1.1 USD
2026-01-02 * "options and other directives change nothing here"
  Assets:A  1.50 EUR
  Assets:B
2026-12-31 close Assets:B
