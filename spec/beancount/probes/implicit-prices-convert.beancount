plugin "beancount.plugins.implicit_prices"

2026-01-01 open Assets:Btc
2026-01-01 open Assets:Eth
2026-01-01 open Assets:Bank
2026-01-01 open Assets:Usd
2026-01-01 open Equity:Other

; BTC: priced by postings only, in EUR
2026-01-02 * "btc, per unit"
  Assets:Btc    2 BTC @ 100.00 EUR
  Assets:Bank  -200.00 EUR

2026-01-04 * "btc, total"
  Assets:Btc    4 BTC @@ 520 EUR
  Assets:Bank  -520 EUR

; ETH: a price directive and a posting on the same day, the directive written below
2026-01-03 * "eth, per unit"
  Assets:Eth    1 ETH @ 30 EUR
  Assets:Bank  -30 EUR

2026-01-03 price ETH 31 EUR

; the same day, the directive written above
2026-01-05 price ETH 40 EUR

2026-01-05 * "eth, per unit"
  Assets:Eth    1 ETH @ 41 EUR
  Assets:Bank  -41 EUR

; USD priced in EUR by a posting: a rate for USD in EUR, and its inverse is one for EUR in USD
2026-01-02 * "usd per euro"
  Assets:Usd    100 USD @ 0.5 EUR
  Assets:Bank  -50 EUR

2026-01-06 * "cost only"
  Assets:Eth    1 ETH {50 EUR}
  Assets:Bank  -50 EUR
